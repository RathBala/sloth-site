{
  "name": "sloth-money-landing",
  "version": "1.0.0",
  "description": "Sloth Money - The Budgeting App Built for Two",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "posthog:config": "node ./scripts/generate-posthog-config.mjs",
    "meta:config": "node ./scripts/generate-meta-pixel-config.mjs",
    "dev:css": "tailwindcss -i ./src/assets/css/tailwind.css -o ./src/output.css --watch",
    "dev:server": "browser-sync start --server src --index index.html --port 3000 --files 'src/**/*' --no-notify",
    "build:css": "tailwindcss -i ./src/assets/css/tailwind.css -o ./src/output.css --minify",
    "build": "yarn posthog:config && yarn build:css",
    "dev": "yarn posthog:config && concurrently \"yarn dev:css\" \"yarn dev:server\" --names \"CSS,SERVER\" --prefix-colors \"blue,green\"",
    "asset:prepare-sloth": "node ./scripts/prepare-sloth-asset.mjs",
    "check:archetype-gate": "node ./scripts/check-archetype-gate.mjs",
    "check:copy": "node ./scripts/check-home-copy.mjs",
    "check:footer": "node ./scripts/check-shared-footer.mjs",
    "check:tracking": "node ./scripts/check-tracking-privacy.mjs",
    "lint": "prettier --check .",
    "typecheck": "node ./scripts/typecheck.mjs"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.7",
    "http-server": "^14.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.7"
  },
  "resolutions": {
    "glob": "10.5.0",
    "qs": "6.15.2",
    "shell-quote": "1.8.4",
    "ws": "8.21.0"
  }
}
